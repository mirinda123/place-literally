ES_URL=http://localhost:9200
ES_INDEX=features-v10
# This controls Chinese names. literal_meanings.translations.zh uses IK independently.
# cjk is built in. smartcn / ik_smart require the corresponding ES plugin.
ES_ANALYZER=cjk
# ES_API_KEY=
# ES_USERNAME=elastic
# ES_PASSWORD=
# ES_CA_CERTS=C:/path/to/http_ca.crt
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional for backend.embed_meanings; keep the real key in ignored backend/.env or an environment variable.
# DASHSCOPE_API_KEY=
# DASHSCOPE_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
